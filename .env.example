# ---------- Odoo-Datenbank (PostgreSQL) ----------
# Hostname der Datenbank: Dienstname im Docker-Netz (z. B. "db"), IP-Adresse
# oder host.docker.internal, wenn PostgreSQL direkt auf dem Server läuft.
PGHOST=db
PGPORT=5432
PGDATABASE=odoo
# Eigener Benutzer NUR mit Leserechten, siehe sql/readonly_user.sql
PGUSER=erechnung_ro
PGPASSWORD=bitte-aendern
PGSSLMODE=prefer

# ---------- Odoo ----------
# Adresse, unter der Mitarbeiter Odoo öffnen (für die Links "In Odoo öffnen")
ODOO_URL=https://hogakaprofi.de
# Firma, deren Einstellungen (Format, Versand, Barcode, Peppol-Status) gelten.
# Leer = erste Firma mit Land Deutschland.
ODOO_COMPANY_ID=

# ---------- Prüfung ----------
# Vier-Augen-Kontrolle für Änderungen ab diesem Datum (JJJJ-MM-TT)
KONTROLLE_AB=2025-01-01
# Welche Kontakte werden geprüft?
#   alle                = alle aktiven Kontakte außer eigene Firmen, Benutzer, Mitarbeiter (Standard)
#   rechnungsempfaenger = nur Unternehmen/Einzelkontakte, Rechnungsadressen und Kontakte mit Rechnungen
PRUEF_UMFANG=alle
# Massenänderungen brauchen keine Vier-Augen-Kontrolle: Ändert eine Person in derselben
# Minute mehr Kontakte als hier angegeben (Import, Migration, Serveraktion), zählt das nicht.
MASSEN_GRENZE=30
# Archivierte Kontakte mitladen (true/false)
INCLUDE_INACTIVE=false
TZ_ANZEIGE=Europe/Berlin

# ---------- Webseite ----------
APP_PORT=8080
# Ergebnis so viele Sekunden wiederverwenden (Knopf "Neu laden" liest immer sofort neu)
CACHE_SECONDS=120
# Passwortschutz der Seite (beide leer = aus). Dringend empfohlen, die Seite zeigt Kundendaten.
APP_USER=
APP_PASSWORD=
